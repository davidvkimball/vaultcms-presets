{
  "projectRoot": "../..",
  "configFilePath": "../config.ts",
  "contentTypes": [
    {
      "id": "posts-continuum",
      "name": "Posts",
      "folder": "posts",
      "fileOrganization": "file",
      "indexFileName": "index",
      "linkBasePath": "/posts/",
      "enabled": true
    },
    {
      "id": "projects-continuum",
      "name": "Projects",
      "folder": "projects",
      "fileOrganization": "file",
      "indexFileName": "index",
      "linkBasePath": "/projects/",
      "enabled": true
    },
    {
      "id": "pages-continuum",
      "name": "Pages",
      "folder": "pages",
      "fileOrganization": "file",
      "indexFileName": "index",
      "linkBasePath": "/",
      "enabled": true
    },
    {
      "id": "special-continuum",
      "name": "Special Pages",
      "folder": "special",
      "fileOrganization": "file",
      "indexFileName": "index",
      "linkBasePath": "/",
      "enabled": true
    }
  ],
  "frontmatterProperties": {
    "posts-continuum": {
      "titleProperty": "title",
      "dateProperty": "date",
      "descriptionProperty": "description",
      "tagsProperty": "tags",
      "draftProperty": "draft",
      "draftLogic": "true-draft",
      "hasDraftStatus": true,
      "imageProperty": "image",
      "template": "---\ntitle: \"{{title}}\"\ndate: {{date}}\ndescription: \"\"\ntags: []\nimage: \"\"\nimageAlt: \"\"\nimageOG: false\nhideCoverImage: false\nfeatured: false\naccent: \"\"\ntargetKeyword: \"\"\ndraft: true\n---\n"
    },
    "projects-continuum": {
      "titleProperty": "title",
      "dateProperty": "date",
      "descriptionProperty": "description",
      "tagsProperty": "tags",
      "draftProperty": "draft",
      "draftLogic": "true-draft",
      "hasDraftStatus": true,
      "imageProperty": "image",
      "template": "---\ntitle: \"{{title}}\"\ndescription: \"\"\ndate: {{date}}\ntags: []\nstatus: \"\"\nprojectUrl: \"\"\nrepositoryUrl: \"\"\nimage: \"\"\nimageAlt: \"\"\naccent: \"\"\ntile: medium\nicon: \"\"\nfeatured: false\ndraft: true\n---\n"
    },
    "pages-continuum": {
      "titleProperty": "title",
      "descriptionProperty": "description",
      "draftProperty": "draft",
      "draftLogic": "true-draft",
      "hasDraftStatus": true,
      "imageProperty": "image",
      "template": "---\ntitle: \"{{title}}\"\ndescription: \"\"\nimage: \"\"\nnoIndex: false\ndraft: false\n---\n"
    },
    "special-continuum": {
      "titleProperty": "title",
      "descriptionProperty": "description",
      "hasDraftStatus": false,
      "template": "---\ntitle: \"{{title}}\"\ndescription: \"\"\n---\n"
    }
  },
  "attachmentHandlingMode": "subfolder",
  "preset": "vanilla",
  "presetName": "",
